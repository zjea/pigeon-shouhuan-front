			GetLabelValue
			
		} from '../interface.uts';

/* 引入 unierror.uts 文件中定义的变量 */
import { MyApiFailImpl } from '../unierror';

/**
 * 引入三方库
 * [可选实现，按需引入]
 *
 * 在 Android 平台引入三方库有以下两种方式：
 * 1、[推荐] 通过 仓储 方式引入，将 三方库的依赖信息 配置到 config.json 文件下的 dependencies 字段下。详细配置方式[详见](https://uniapp.dcloud.net.cn/plugin/uts-plugin.html#dependencies)
 * 2、直接引入，将 三方库的aar或jar文件 放到libs目录下。更多信息[详见](https://uniapp.dcloud.net.cn/plugin/uts-plugin.html#android%E5%B9%B3%E5%8F%B0%E5%8E%9F%E7%BD%AE)
 *
 * 在通过上述任意方式依赖三方库后，使用时需要在文件中 import，如下示例：
 * import { LottieAnimationView } from 'com.airbnb.lottie.LottieAnimationView'
 */
// import { Device } from "com.example.handheld.lib.Device";
import Device from "com.example.handheld.lib.Device";
import OnConnectionListener from "com.example.handheld.lib.OnConnectionListener";
import OnBatteryListener from "com.example.handheld.lib.OnBatteryListener";
import OnUHFListener from "com.example.handheld.lib.OnUHFListener";
import Common from "com.example.handheld.lib.Common";

import Context from 'android.content.Context';
import { UTSAndroid } from "io.dcloud.uts";
import Log from "android.util.Log";
import array from 'android.R.array';

var context = UTSAndroid.getAppContext();
var device = Device.getInstance(context);
var power: Int = 16;

var currentLabel: string = "";

export const watchConnect : WatchConnect = function(id : string): boolean {
	console.log("传给SDK的connect（）方法的id位："+id);
	const b = device.connect(id); 
	console.log("当前蓝牙是否连接---"+b);
	if(b){
		class ConnListener implements OnConnectionListener {
		    override onConnecting():void{
				console.log("蓝牙连接中！！！！！");
		    }
			  
			override onConnected():void{
				console.log("蓝牙连接成功！！！！！");
			}
			override onFailed():void{
				
			}
			override onDisconnected():void{
				console.log("蓝牙断开！！！！！！");
			}
		};
		device.setOnConnectionListener(new ConnListener());
		console.log("开启连接监听器---");
		
		class BatteryListener implements OnBatteryListener{
			override onBattery(battery : Int):void{
				Log.e("onBatteryListener","battery:"+battery);
			}
			override onCharge(flag : boolean ):void{
			}
		}
		device.setOnBatteryListener(new BatteryListener());
		console.log("开启电池监听器---");
		
		try{
			device.setPower(18);
			console.log("设置设备功率为---"+18);
		}catch(e){
			console.log("设置设备功率出错---"+e);
		}
		
	}
	
	return b;
}

export const watchBattery : WatchBattery = function(): number {
	 try{
		let a = device.getBattery();
		Log.d("handheld_p", "getBattery: " + a);
		return a[0];
	 }catch(e){
		console.log("3......................"+e);
	 }
	return -1;
}

export const getWatchVersion : GetWatchVersion = function(): string {
	return device.getVersion();
}

export const onGetLabelId : GetLabelId = function(callback: (label: string) => void): void{
	currentLabel = "";
	class UHFListener implements OnUHFListener{
		override onInventory(pc: ByteArray, epc: ByteArray, rssi: Int):void{
			const _epc:string = Common.bytes2String(epc, 0, epc.count()).replaceAll(" ","");
			currentLabel = _epc;
		}
		
		override onInventoryStop():void{
			console.log("停止读卡功能！！！！！");
			currentLabel = "";
		}
	}
	device.setOnUHFListener(new UHFListener());
	console.log("开启读卡监听器---");
	device.inventory();
}

export const getLabelValue : GetLabelValue = function(): string {
	return currentLabel;
}

export const closeGetLabelId: CloseGetLabelId = function(): void{
	device.stopInventory();
	currentLabel = "";
	console.log("关闭连续读卡功能！！！！！");
}

export const watchDisconnect: WatchDisconnect = function(): void{
	device.disconnect();
	console.log("断开蓝牙！！！！！");
}